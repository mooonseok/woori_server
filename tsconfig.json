{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@App/*": ["src/*"],
      "@Domain/*": ["src/domain/*"],
      "@Common/*": ["src/common/*"],
      "@Admin/*": ["src/admin/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "integration/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
