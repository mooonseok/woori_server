{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build"
  },
  "deploy": {
    "startCommand": "node scripts/r2-backup.mjs --apply",
    "cronSchedule": "0 18 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
