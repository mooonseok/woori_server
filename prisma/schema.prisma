generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["woori"]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@schema("woori")
}

enum GroupStatus {
  ACTIVE
  DELETING
  DELETED

  @@schema("woori")
}

enum MembershipStatus {
  ACTIVE
  PENDING
  LEFT
  REMOVED

  @@schema("woori")
}

enum MemberRole {
  OWNER
  MEMBER

  @@schema("woori")
}

enum PhotoStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  DELETING
  DELETED

  @@schema("woori")
}

enum CommentKind {
  GENERAL
  PIN

  @@schema("woori")
}

enum MailKind {
  VERIFY_EMAIL
  RECOVER_USERNAME
  RESET_PASSWORD
  CHANGE_EMAIL
  EMAIL_CHANGED_NOTICE

  @@schema("woori")
}

enum MediaKind {
  PHOTO
  VIDEO

  @@schema("woori")
}

enum NotificationKind {
  PHOTOS
  COMMENT
  PIN
  REACTION
  JOIN_REQUEST
  JOIN_RESULT
  MEMORY

  @@schema("woori")
}

enum GroupNotificationMode {
  DEFAULT
  MINE
  OFF

  @@schema("woori")
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED

  @@schema("woori")
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@schema("woori")
}

enum InquiryCategory {
  ACCOUNT
  GROUP
  PHOTO
  NOTIFICATION
  BUG
  OTHER

  @@schema("woori")
}

enum InquiryStatus {
  RECEIVED
  IN_PROGRESS
  ANSWERED
  CLOSED

  @@schema("woori")
}

enum ReportTargetType {
  PHOTO
  COMMENT
  USER

  @@schema("woori")
}

enum ReportReason {
  INAPPROPRIATE
  HARASSMENT
  PRIVACY
  SPAM
  OTHER

  @@schema("woori")
}

enum ReportStatus {
  RECEIVED
  REVIEWING
  RESOLVED
  DISMISSED

  @@schema("woori")
}

enum AdminStatus {
  ACTIVE
  DISABLED

  @@schema("woori")
}

model User {
  id                     String                        @id @default(uuid()) @db.Uuid
  username               String                        @unique @db.VarChar(64)
  displayName            String                        @db.VarChar(80)
  email                  String                        @unique @db.VarChar(254)
  passwordHash           String                        @db.VarChar(512)
  status                 UserStatus                    @default(ACTIVE)
  verifiedAt             DateTime?                     @db.Timestamptz(6)
  createdAt              DateTime                      @default(now()) @db.Timestamptz(6)
  emailTokens            EmailToken[]
  createdInvitations     Invitation[]
  ownedGroups            Group[]
  memberships            Membership[]
  albums                 Album[]
  photos                 Photo[]
  comments               Comment[]
  reactions              Reaction[]
  sessions               Session[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  groupPreferences       GroupNotificationPreference[]
  installations          PushInstallation[]
  memoryPreferences      PhotoMemoryPreference[]
  inquiries              Inquiry[]
  reportsFiled           ContentReport[]               @relation("ReportsFiled")
  reportsReceived        ContentReport[]               @relation("ReportsReceived")
  blocks                 UserBlock[]                   @relation("Blocker")
  blockedBy              UserBlock[]                   @relation("BlockedUser")
  mails                  MailOutbox[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("users")
  @@schema("woori")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(128)
  audience  String    @db.VarChar(16)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  installations PushInstallation[]

  @@index([userId, expiresAt])
  @@map("sessions")
  @@schema("woori")
}

model Group {
  id                  String                        @id @default(uuid()) @db.Uuid
  name                String                        @db.VarChar(100)
  ownerId             String                        @db.Uuid
  status              GroupStatus                   @default(ACTIVE)
  quotaBytes          BigInt                        @default(21474836480)
  usedBytes           BigInt                        @default(0)
  // W07-4: when deletion was requested (group cleanup queue lag).
  deletionRequestedAt DateTime?                     @db.Timestamptz(6)
  createdAt           DateTime                      @default(now()) @db.Timestamptz(6)
  owner               User                          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  invitations         Invitation[]
  memberships         Membership[]
  albums              Album[]
  photos              Photo[]
  notifications       Notification[]
  preferences         GroupNotificationPreference[]
  reports             ContentReport[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([ownerId, status])
  @@map("groups")
  @@schema("woori")
}

model Membership {
  groupId  String           @db.Uuid
  userId   String           @db.Uuid
  role     MemberRole       @default(MEMBER)
  status   MembershipStatus @default(PENDING)
  joinedAt DateTime?        @db.Timestamptz(6)
  group    Group            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([groupId, userId])
  @@index([userId, status])
  @@map("memberships")
  @@schema("woori")
}

model Album {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  creatorId String    @db.Uuid
  title     String    @db.VarChar(160)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  photos    Photo[]

  @@unique([id, groupId])
  @@index([groupId, deletedAt, createdAt])
  @@map("albums")
  @@schema("woori")
}

model Photo {
  id                       String                  @id @default(uuid()) @db.Uuid
  groupId                  String                  @db.Uuid
  albumId                  String                  @db.Uuid
  uploaderId               String                  @db.Uuid
  status                   PhotoStatus             @default(PENDING)
  bytes                    BigInt                  @default(0)
  width                    Int?
  height                   Int?
  capturedAt               DateTime?               @db.Timestamptz(6)
  captureDateSource        String?                 @db.VarChar(24)
  manualCapturedDate       DateTime?               @db.Date
  captureMetadataCheckedAt DateTime?               @db.Timestamptz(6)
  stagingKey               String?                 @db.VarChar(512)
  uploadMime               String?                 @db.VarChar(80)
  uploadBytes              BigInt                  @default(0)
  reservedBytes            BigInt                  @default(0)
  uploadExpiresAt          DateTime?               @db.Timestamptz(6)
  processingToken          String?                 @db.Uuid
  processingUntil          DateTime?               @db.Timestamptz(6)
  processingQueuedAt       DateTime?               @db.Timestamptz(6)
  processingAvailableAt    DateTime?               @db.Timestamptz(6)
  processingDeadlineAt     DateTime?               @db.Timestamptz(6)
  processingAttempts       Int                     @default(0)
  processingErrorCode      String?                 @db.VarChar(48)
  // W07-3: set at upload reservation and never changed. A VIDEO keeps only
  // its transcoded MP4 ('video' variant) and posters; durationMs once READY.
  mediaKind                MediaKind               @default(PHOTO)
  durationMs               Int?
  createdAt                DateTime                @default(now()) @db.Timestamptz(6)
  deletedAt                DateTime?               @db.Timestamptz(6)
  group                    Group                   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  album                    Album                   @relation(fields: [albumId, groupId], references: [id, groupId], onDelete: Restrict)
  uploader                 User                    @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  variants                 PhotoVariant[]
  memoryPreferences        PhotoMemoryPreference[]
  comments                 Comment[]
  reactions                Reaction[]

  @@unique([id, groupId])
  @@index([albumId, status, createdAt, id])
  @@index([groupId, status, uploadExpiresAt])
  @@index([uploaderId, status])
  @@index([status, processingQueuedAt])
  @@map("photos")
  @@schema("woori")
}

model PhotoVariant {
  id        String @id @default(uuid()) @db.Uuid
  photoId   String @db.Uuid
  kind      String @db.VarChar(16)
  objectKey String @unique @db.VarChar(512)
  mime      String @db.VarChar(80)
  width     Int
  height    Int
  bytes     BigInt
  photo     Photo  @relation(fields: [photoId], references: [id], onDelete: Restrict)

  @@unique([photoId, kind])
  @@map("photo_variants")
  @@schema("woori")
}

model Comment {
  id        String      @id @default(uuid()) @db.Uuid
  groupId   String      @db.Uuid
  photoId   String      @db.Uuid
  authorId  String      @db.Uuid
  body      String      @db.VarChar(2000)
  kind      CommentKind @default(GENERAL)
  x         Float?
  y         Float?
  parentId  String?     @db.Uuid
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  deletedAt DateTime?   @db.Timestamptz(6)
  photo     Photo       @relation(fields: [photoId, groupId], references: [id, groupId], onDelete: Restrict)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent    Comment?    @relation("CommentReplies", fields: [parentId, photoId], references: [id, photoId], onDelete: Restrict, onUpdate: NoAction)
  replies   Comment[]   @relation("CommentReplies")

  @@unique([id, photoId])
  @@index([photoId, createdAt])
  @@index([authorId])
  @@map("comments")
  @@schema("woori")
}

model Reaction {
  photoId   String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([photoId, userId])
  @@map("reactions")
  @@schema("woori")
}

model NotificationPreference {
  userId           String  @id @db.Uuid
  enabled          Boolean @default(true)
  photos           Boolean @default(true)
  comments         Boolean @default(true)
  reactions        Boolean @default(true)
  join             Boolean @default(true)
  memories         Boolean @default(false)
  preview          Boolean @default(false)
  quietEnabled     Boolean @default(false)
  quietStartMinute Int     @default(1320)
  quietEndMinute   Int     @default(480)
  timeZone         String  @default("Asia/Seoul") @db.VarChar(64)
  version          Int     @default(0)
  user             User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("notification_preferences")
  @@schema("woori")
}

model GroupNotificationPreference {
  userId  String                @db.Uuid
  groupId String                @db.Uuid
  mode    GroupNotificationMode @default(DEFAULT)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  group   Group                 @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([userId, groupId])
  @@map("group_notification_preferences")
  @@schema("woori")
}

model Notification {
  id                  String                 @id @default(uuid()) @db.Uuid
  recipientId         String                 @db.Uuid
  groupId             String                 @db.Uuid
  kind                NotificationKind
  targetId            String                 @db.Uuid
  dedupeKey           String                 @db.VarChar(256)
  readThroughSequence Int                    @default(0)
  // Upload/reaction bundles (W07): the key groups activity per recipient, the
  // window end is fixed when the bundle opens (anchored on its first activity)
  // and lastSequence is the monotonic activity counter. Null key: single event.
  bundleKey           String?                @db.VarChar(256)
  bundleUntil         DateTime?              @db.Timestamptz(6)
  lastSequence        Int                    @default(1)
  createdAt           DateTime               @default(now()) @db.Timestamptz(6)
  recipient           User                   @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  group               Group                  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  activities          NotificationActivity[]
  deliveries          NotificationDelivery[]

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, createdAt])
  @@index([recipientId, bundleKey, bundleUntil])
  @@map("notifications")
  @@schema("woori")
}

model NotificationActivity {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @db.Uuid
  actorId        String       @db.Uuid
  sequence       Int
  eventKey       String       @db.VarChar(256)
  // The uploaded photo of a PHOTOS bundle activity (null: the notification target).
  photoId        String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@unique([notificationId, eventKey])
  @@unique([notificationId, sequence])
  @@map("notification_activities")
  @@schema("woori")
}

model PushInstallation {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @db.Uuid
  provider           String                 @db.VarChar(16)
  sessionId          String?                @db.Uuid
  session            Session?               @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  bindingVersion     Int                    @default(1)
  boundAt            DateTime               @default(now()) @db.Timestamptz(6)
  expiresAt          DateTime?              @db.Timestamptz(6)
  endpointCiphertext String
  endpointHash       String                 @unique @db.VarChar(128)
  enabled            Boolean                @default(true)
  revokedAt          DateTime?              @db.Timestamptz(6)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries         NotificationDelivery[]

  @@index([sessionId])
  @@map("push_installations")
  @@schema("woori")
}

model NotificationDelivery {
  id             String           @id @default(uuid()) @db.Uuid
  notificationId String           @db.Uuid
  installationId String           @db.Uuid
  deliveryKey    String           @unique @db.VarChar(256)
  status         JobStatus        @default(PENDING)
  attempts       Int              @default(0)
  nextAttemptAt  DateTime         @default(now()) @db.Timestamptz(6)
  leaseUntil     DateTime?        @db.Timestamptz(6)
  bindingVersion Int              @default(1)
  leaseToken     String?          @db.Uuid
  resultCode     String?          @db.VarChar(48)
  notification   Notification     @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  installation   PushInstallation @relation(fields: [installationId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([notificationId])
  // Migration-only partial unique index (not expressible here):
  // notification_deliveries_one_waiting_idx (notificationId, installationId)
  // WHERE status IN ('PENDING','RUNNING').
  @@map("notification_deliveries")
  @@schema("woori")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventKey      String    @unique @db.VarChar(256)
  type          String    @db.VarChar(80)
  aggregateId   String    @db.Uuid
  payload       Json
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(6)
  leaseUntil    DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([aggregateId])
  @@map("outbox_events")
  @@schema("woori")
}

model EmailToken {
  targetEmail String?      @db.VarChar(254)
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  tokenHash   String       @unique @db.VarChar(128)
  purpose     String       @db.VarChar(32)
  expiresAt   DateTime     @db.Timestamptz(6)
  consumedAt  DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  mails       MailOutbox[]

  @@index([userId, purpose, expiresAt])
  @@map("email_tokens")
  @@schema("woori")
}

// W07-4 mail outbox: written in the same transaction as the token it carries.
// payload is AES-256-GCM (MAIL_OUTBOX_KEY, bound to id) of the recipient and
// the raw token/username; it is nulled once the mail is sent, expired or failed.
// A token-backed mail is sent only while its token is unconsumed and unexpired.
model MailOutbox {
  id            String      @id @db.Uuid
  kind          MailKind
  userId        String      @db.Uuid
  emailTokenId  String?     @db.Uuid
  payload       String?
  status        JobStatus   @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now()) @db.Timestamptz(6)
  leaseUntil    DateTime?   @db.Timestamptz(6)
  leaseToken    String?     @db.Uuid
  expiresAt     DateTime    @db.Timestamptz(6)
  resultCode    String?     @db.VarChar(48)
  sentAt        DateTime?   @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  emailToken    EmailToken? @relation(fields: [emailTokenId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([emailTokenId])
  @@index([createdAt])
  @@map("mail_outbox")
  @@schema("woori")
}

// W07-4 monitoring: one row per worker process, updated after every pass
// (beatAt on the database clock).
model WorkerHeartbeat {
  instanceId String    @id @db.VarChar(64)
  startedAt  DateTime  @db.Timestamptz(6)
  beatAt     DateTime  @db.Timestamptz(6)
  lastPassOk Boolean
  videoReady Boolean
  busyJob    String?   @db.VarChar(48)
  busySince  DateTime? @db.Timestamptz(6)

  @@map("worker_heartbeats")
  @@schema("woori")
}

model RateLimitBucket {
  id          String   @id @db.VarChar(128)
  windowStart DateTime @db.Timestamptz(6)
  attempts    Int      @default(0)

  @@index([windowStart])
  @@map("rate_limit_buckets")
  @@schema("woori")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @db.Uuid
  createdById String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(128)
  codeHash    String    @unique @db.VarChar(128)
  expiresAt   DateTime  @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  maxUses     Int
  useCount    Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  creator     User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
  @@map("invitations")
  @@schema("woori")
}

model MediaCleanupJob {
  id          String    @id @default(uuid()) @db.Uuid
  photoId     String    @unique @db.Uuid
  objectKeys  String[]
  availableAt DateTime  @db.Timestamptz(6)
  attempts    Int       @default(0)
  lockedUntil DateTime? @db.Timestamptz(6)
  lockToken   String?   @db.Uuid
  completedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  @@index([completedAt, availableAt, lockedUntil])
  @@map("media_cleanup_jobs")
  @@schema("woori")
}

model PhotoMemoryPreference {
  userId   String    @db.Uuid
  photoId  String    @db.Uuid
  hiddenAt DateTime? @db.Timestamptz(6)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  photo    Photo     @relation(fields: [photoId], references: [id], onDelete: Restrict)

  @@id([userId, photoId])
  @@map("photo_memory_preferences")
  @@schema("woori")
}

model Notice {
  id          String       @id @default(uuid()) @db.Uuid
  title       String       @db.VarChar(120)
  body        String       @db.VarChar(10000)
  status      NoticeStatus @default(DRAFT)
  publishedAt DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([updatedAt(sort: Desc), id(sort: Desc)])
  @@map("notices")
  @@schema("woori")
}

model Inquiry {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  category   InquiryCategory
  title      String          @db.VarChar(100)
  body       String          @db.VarChar(2000)
  status     InquiryStatus   @default(RECEIVED)
  answer     String?         @db.VarChar(4000)
  answeredAt DateTime?       @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(6)
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("inquiries")
  @@schema("woori")
}

model ContentReport {
  id           String           @id @default(uuid()) @db.Uuid
  reporterId   String           @db.Uuid
  groupId      String           @db.Uuid
  targetType   ReportTargetType
  targetId     String           @db.Uuid
  targetUserId String           @db.Uuid
  reason       ReportReason
  detail       String?          @db.VarChar(500)
  status       ReportStatus     @default(RECEIVED)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)
  resolvedAt   DateTime?        @db.Timestamptz(6)
  // Operator-only outcome (CONTENT_DELETED | USER_SUSPENDED | NO_ACTION).
  resolution   String?          @db.VarChar(32)
  reporter     User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Restrict)
  targetUser   User             @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: Restrict)
  group        Group            @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([reporterId, targetType, targetId])
  @@index([reporterId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt])
  @@index([targetType, targetId, status])
  @@index([targetUserId, status])
  @@map("content_reports")
  @@schema("woori")
}

model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Restrict)
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Restrict)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
  @@schema("woori")
}

// Service operator accounts are separate from member accounts. Accounts are
// created, disabled and MFA-reset only by the owner-connection CLI; the runtime
// role may update only login-state columns (see runtime-grants.sql).
model AdminAccount {
  id                   String          @id @default(uuid()) @db.Uuid
  username             String          @unique @db.VarChar(64)
  displayName          String          @db.VarChar(80)
  passwordHash         String          @db.VarChar(512)
  status               AdminStatus     @default(ACTIVE)
  totpSecretCiphertext String?
  totpEnabledAt        DateTime?       @db.Timestamptz(6)
  totpLastUsedStep     BigInt?
  failedLoginCount     Int             @default(0)
  lockedUntil          DateTime?       @db.Timestamptz(6)
  passwordChangedAt    DateTime        @default(now()) @db.Timestamptz(6)
  lastLoginAt          DateTime?       @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  sessions             AdminSession[]
  auditLogs            AdminAuditLog[]

  @@map("admin_accounts")
  @@schema("woori")
}

model AdminSession {
  id             String       @id @default(uuid()) @db.Uuid
  adminId        String       @db.Uuid
  tokenHash      String       @unique @db.VarChar(128)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime     @db.Timestamptz(6)
  idleExpiresAt  DateTime     @db.Timestamptz(6)
  mfaVerifiedAt  DateTime?    @db.Timestamptz(6)
  reauthAt       DateTime?    @db.Timestamptz(6)
  mfaFailedCount Int          @default(0)
  revokedAt      DateTime?    @db.Timestamptz(6)
  admin          AdminAccount @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@map("admin_sessions")
  @@schema("woori")
}

// Append-only: the runtime role may only SELECT and INSERT.
model AdminAuditLog {
  id         String        @id @default(uuid()) @db.Uuid
  adminId    String?       @db.Uuid
  action     String        @db.VarChar(64)
  targetType String?       @db.VarChar(32)
  targetId   String?       @db.Uuid
  reason     String?       @db.VarChar(500)
  metadata   Json          @default("{}")
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  admin      AdminAccount? @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc), id(sort: Desc)])
  @@map("admin_audit_logs")
  @@schema("woori")
}
