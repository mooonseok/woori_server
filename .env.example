# Local .env is gitignored; scripts dev/start/migrate load it through Node's env-file support.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3210
CORS_ALLOWED_ORIGINS=http://localhost:3210,http://localhost:3002
TRUST_PROXY_HOPS=0
# Runtime: dedicated woori_api login, NOBYPASSRLS, runtime-grants.sql applied.
DATABASE_URL=postgresql://woori_api:REPLACE@127.0.0.1:55439/woori_dev
# Migration: separate privileged connection, only explicit migration command uses it.
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE@127.0.0.1:55439/woori_dev
# Development only: no real email is sent. Blank uses the current user's ~/.woori/dev-mail.
# Optional override: absolute private directory outside repo; no machine-specific path needed.
MAIL_MODE=file
DEV_MAIL_DIR=
# Production: HTTPS WEB_ORIGIN and exact CORS origins, same-site web/API domains.
# Use direct/session-mode Supabase connection with verified TLS for both roles.
# MAIL_MODE=resend
# RESEND_API_KEY=...
# MAIL_FROM=우리 <no-reply@your-verified-domain>
# TRUST_PROXY_HOPS=1 only when every HTTP request traverses the single trusted platform proxy.

# Private R2 Standard bucket. Leave unset to disable photo writes while keeping auth/groups usable.
# No NEXT_PUBLIC prefix. Never enable r2.dev or a public custom domain for this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Browser direct PUT needs bucket CORS allowing http://localhost:3210 and Content-Type.
# Add a lifecycle rule only for the staging/ prefix to delete abandoned uploads after 1 day.

# Web Push: all four settings required; empty disables subscription and dispatch.
# Generate once: pnpm push:keys mailto:your-contact@example.com (new private file; no secrets printed).
# Copy four values from .env.web-push.local into API/worker env. Public key is returned by /v1/push/config.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
# base64 32-byte key (node crypto.randomBytes(32)); shared API/worker, keep stable and private.
PUSH_ENCRYPTION_KEY=
# Worker: separate long-running pnpm start:worker service, same DB and four settings.
# Apply web-push migration + runtime grants explicitly before starting API/worker.

# Admin (service operator) API: both settings required; empty keeps member API running
# and every /v1/admin route answers 503 ADMIN_NOT_CONFIGURED.
# ADMIN_WEB_ORIGIN must also be listed in CORS_ALLOWED_ORIGINS (startup fails otherwise).
ADMIN_WEB_ORIGIN=http://localhost:3002
# base64 32-byte AES-256-GCM key for admin TOTP secrets. Generate once: pnpm admin:keys
# (writes new private .env.admin.local; never printed). Changing it requires admin:reset-mfa.
ADMIN_TOTP_ENCRYPTION_KEY=
# First admin: pnpm build, then pnpm admin:create --username <id> --display-name <name>
# --confirm-database <db name from MIGRATION_DATABASE_URL> (password prompted twice, no echo).
